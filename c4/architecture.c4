// Koperasi KS3 — reference C4 architecture model.
//
// Naming convention:
// - L1 = System Context
// - L2 = Container
// - L3 = Component
// - L4 = Code
// - FLOW = Dynamic behavior using elements from L1-L4; this is not a fifth C4 level.
//
// Scope and evidence:
// - Models the current Django 6 / Wagtail 7 monolith in this repository.
// - Production uses Gunicorn, PostgreSQL, S3-compatible object storage, Xendit, and SMTP.
// - Development/test storage and database implementations differ; see element descriptions.
// - Source paths in L4 descriptions provide traceability to implementation.

specification {
  // L1 is green/gray, L2 is indigo/amber, L3 is secondary, and L4 uses
  // interface/domain/operation colors. Prefixes remain in every title so the
  // level is still unambiguous when colors are unavailable.
  element person {
    notation "L1 · Person"
    style {
      shape person
      color green
    }
  }

  element externalSystem {
    notation "L1 · External System"
    style {
      color gray
    }
  }

  element softwareSystem {
    notation "L1 · Software System / Boundary"
    style {
      color indigo
      opacity 10%
      border solid
    }
  }

  element container {
    notation "L2 · Application / CLI Container"
    style {
      color primary
      opacity 10%
      border solid
    }
  }

  element database {
    notation "L2 · Data Container"
    style {
      shape cylinder
      color amber
    }
  }

  element component {
    notation "L3 · Component / Responsibility Boundary"
    style {
      shape component
      color secondary
      opacity 10%
      border dashed
    }
  }

  element endpoint {
    notation "L4 · HTTP Endpoint / Route"
    style {
      shape browser
      color red
    }
  }

  element viewFunction {
    notation "L4 · HTTP View / Controller"
    style {
      color indigo
    }
  }

  element form {
    notation "L4 · Input Form / Validator"
    style {
      color green
    }
  }

  element workflow {
    notation "L4 · Application Workflow"
    style {
      shape component
      color green
    }
  }

  element service {
    notation "L4 · Service"
    style {
      shape component
      color green
    }
  }

  element domainModel {
    notation "L4 · Domain Model / Value Object"
    style {
      shape storage
      color amber
    }
  }

  element settingsModel {
    notation "L4 · Runtime Configuration Model"
    style {
      shape document
      color amber
    }
  }

  element template {
    notation "L4 · HTML/Text Template"
    style {
      shape document
      color gray
    }
  }

  element browserScript {
    notation "L4 · Browser-side Script"
    style {
      color indigo
    }
  }

  element managementCommand {
    notation "L4 · Management Command"
    style {
      color red
    }
  }

  element adminExtension {
    notation "L4 · Wagtail Admin Extension"
    style {
      color secondary
    }
  }

  element helper {
    notation "L4 · Helper / Query Utility"
    style {
      color muted
    }
  }
}

model {
  // ---------------------------------------------------------------------------
  // L1 — People and external systems
  // ---------------------------------------------------------------------------

  person visitor {
    title "L1 · Public Visitor"
    description "Browses the KS3 homepage, products, public information, and published P2P opportunities."
  }

  person investor {
    title "L1 · P2P Investor"
    description "Submits personal data, reserves P2P slots, pays through Xendit, and receives confirmation."
  }

  person administrator {
    title "L1 · Content & Operations Administrator"
    description "Uses Wagtail Admin to manage content, products, P2P projects, purchases, settings, and reports."
  }

  person operator {
    title "L1 · Developer / Operations Engineer"
    description "Deploys the application and runs Django management commands, including the P2P acceptance harness."
  }

  externalSystem xendit {
    title "L1 · Xendit Payment Gateway"
    description "Creates Payment Sessions, hosts the payment link, returns session status, and sends signed payment-session webhooks."
  }

  externalSystem objectStorage {
    title "L1 · S3-Compatible Object Storage"
    description "Stores production static files and uploaded media through django-storages/boto3. The concrete endpoint and bucket are environment-configured."
  }

  externalSystem smtpProvider {
    title "L1 · SMTP Email Provider"
    description "Delivers transactional paid-purchase email using administrator-managed SMTP settings."
  }

  // ---------------------------------------------------------------------------
  // L1 system with L2 containers
  // ---------------------------------------------------------------------------

  softwareSystem ks3Platform {
    title "L1 · Koperasi KS3 Digital Platform"
    description "Public website, Wagtail CMS, product catalogue, P2P funding workflow, payment reconciliation, notifications, search, and operational reporting."

    container webApplication {
      title "L2 · Django/Wagtail Web Application"
      description "Single deployable web application serving public pages, Wagtail Admin, HTML forms, JSON status endpoints, and Xendit webhooks."
      technology "Python 3.12 · Django 6 · Wagtail 7 · Gunicorn"

      // -----------------------------------------------------------------------
      // L3 components and their L4 code elements
      // -----------------------------------------------------------------------

      component publicExperience {
        title "L3 · Public Website Composition"
        description "Builds homepage and shared navigation from published content, products, P2P projects, miscellaneous pages, and site settings."
        technology "Django views · Wagtail pages/settings · Django templates"

        endpoint landingRoute {
          title "L4 · GET /"
          description "Named route: landing. Explicit homepage route registered before Wagtail's catch-all page router.\nSource: cms/urls.py"
        }

        viewFunction landingView {
          title "L4 · LandingView.get_context_data()"
          description "Loads homepage settings, featured P2P projects, and all featured products grouped into savings and loans for the homepage discovery section.\nSource: cms/views.py"
        }

        endpoint robotsRoute {
          title "L4 · GET /robots.txt"
          description "Named route: robots_txt. Returns crawler directives as text/plain.\nSource: cms/urls.py"
        }

        viewFunction robotsView {
          title "L4 · robots_txt()"
          description "Renders the repository-owned crawler policy template.\nSource: cms/views.py"
        }

        endpoint llmsRoute {
          title "L4 · GET /llms.txt"
          description "Named route: llms_txt. Returns the LLM-readable site summary as text/plain.\nSource: cms/urls.py"
        }

        viewFunction llmsView {
          title "L4 · llms_txt()"
          description "Renders the repository-owned LLM summary template.\nSource: cms/views.py"
        }

        endpoint sitemapRoute {
          title "L4 · GET /sitemap.xml"
          description "Named route: sitemap_xml. Returns the repository-owned XML sitemap.\nSource: cms/urls.py"
        }

        viewFunction sitemapView {
          title "L4 · sitemap_xml()"
          description "Renders the static sitemap template with application/xml content type.\nSource: cms/views.py"
        }

        endpoint wagtailPageRoutes {
          title "L4 · GET /{wagtail_page_path}"
          description "Framework route family: Wagtail resolves all otherwise-unmatched live page URLs. Generated framework internals are intentionally represented as one route family.\nSource: backend/urls.py"
        }

        endpoint debugStaticRoutes {
          title "L4 · DEBUG GET /static/{asset_path}"
          description "Development-only Django staticfiles route family, registered only when settings.DEBUG is true. Production static files use object storage.\nSource: backend/urls.py"
        }

        endpoint debugMediaRoutes {
          title "L4 · DEBUG GET /media/{asset_path}"
          description "Development fallback route family for locally stored media when settings.DEBUG is true and MEDIA_URL is local. Production/dev S3 media bypasses Django.\nSource: backend/urls.py"
        }

        viewFunction globalNavigation {
          title "L4 · global_navigation()"
          description "Builds header/footer navigation from all published products, exposes separate savings and loan menu groups, and loads Wagtail miscellaneous pages.\nSource: _setting/context_processors.py"
        }

        viewFunction globalContactSettings {
          title "L4 · global_contact_settings()"
          description "Injects singleton contact settings into every rendered template.\nSource: _setting/context_processors.py"
        }

        domainModel homePage {
          title "L4 · HomePage"
          description "Wagtail root page type.\nSource: home/models.py"
        }

        settingsModel homePageSetting {
          title "L4 · HomePageSetting"
          description "Site-scoped homepage content and section configuration.\nSource: _setting/models/homepage.py"
        }

        settingsModel contactSetting {
          title "L4 · ContactSetting"
          description "Singleton contact and WhatsApp configuration used by templates and paid confirmation.\nSource: _setting/models/contact.py"
        }

        domainModel miscellaneousIndexPage {
          title "L4 · MiscellaneousIndexPage"
          description "Wagtail index for public informational pages.\nSource: _misc/models/pages.py"
        }

        domainModel miscellaneousPage {
          title "L4 · MiscellaneousPage"
          description "Wagtail content page with navigation placement, SEO, and StreamField content.\nSource: _misc/models/pages.py"
        }

        helper contentBlockLibrary {
          title "L4 · page_content_blocks()"
          description "Reusable headings, paragraphs, images, lists, tables, callouts, accordions, documents, videos, and layout blocks.\nSource: backend/helper/streamfield.py"
        }

        template publicTemplates {
          title "L4 · Public Django Templates"
          description "Server-rendered homepage, content, product, P2P, search, and shared layout templates.\nSource: cms/templates/"
        }
      }

      component productCatalogue {
        title "L3 · Product Catalogue"
        description "Publishes cooperative products and categories with detail content, SEO metadata, and an optional ready financial-simulator profile."
        technology "Django ORM · Wagtail snippets/preview · Django templates"

        endpoint productListRoute {
          title "L4 · GET /product/"
          description "Named route: product. Renders published products.\nSource: _product/urls.py"
        }

        endpoint productLegacyRedirect {
          title "L4 · GET /product"
          description "Named route: product_legacy. Permanent redirect to /product/.\nSource: _product/urls.py"
        }

        endpoint productDetailRoute {
          title "L4 · GET /product/{slug}/"
          description "Named route: product_detail. Renders one published product.\nSource: _product/urls.py"
        }

        viewFunction productListView {
          title "L4 · product_list()"
          description "Loads ProductSEOSettings and the published product query.\nSource: _product/views/pages.py"
        }

        viewFunction productDetailView {
          title "L4 · product_detail()"
          description "Loads a published product by slug, conditionally attaches a ready simulator configuration, and renders its StreamField content.\nSource: _product/views/pages.py"
        }

        helper publishedProducts {
          title "L4 · _published_products()"
          description "Central published-product queryset with active categories, card images, simulator profile, rate tiers, fees, and breakdown bands.\nSource: _product/views/pages.py"
        }

        domainModel product {
          title "L4 · Product"
          description "Catalogue product, publishing state, SEO metadata, media, and StreamField content.\nSource: _product/models/product.py"
        }

        domainModel productCategory {
          title "L4 · ProductCategory"
          description "Ordered and activatable product classification.\nSource: _product/models/category.py"
        }

        settingsModel productSeo {
          title "L4 · ProductSEOSettings"
          description "Singleton SEO defaults for the product listing.\nSource: _product/models/seo.py"
        }
      }

      component productSimulator {
        title "L3 · Product Financial Simulator"
        description "Owns fail-closed product simulation configuration, Decimal-based savings/loan schedules, tiered rate and fee evaluation, adaptive breakdowns, and browser visualization."
        technology "Django ORM · Python Decimal · JSON endpoint · SVG/JavaScript"

        endpoint productSimulationRoute {
          title "L4 · GET /product/{slug}/simulation/"
          description "Named route: product_simulation. Public read-only JSON endpoint for published products; returns 404 when disabled/incomplete and 400 for invalid member inputs.\nSource: _product/urls.py"
        }

        viewFunction productSimulationView {
          title "L4 · product_simulation()"
          description "Requires GET, resolves a published product, enforces enabled/ready configuration, invokes the calculation engine, and returns normalized JSON results.\nSource: _product/views/pages.py"
        }

        helper simulationContext {
          title "L4 · _simulation_context()"
          description "Fail-closed page helper that exposes public simulator configuration only when the optional profile is enabled and complete.\nSource: _product/views/pages.py"
        }

        service simulationEngine {
          title "L4 · simulate()"
          description "Validates inputs, calculates monthly savings or loan schedules using Decimal/ROUND_HALF_UP, aggregates summaries, and returns audit metadata plus chart/table series.\nSource: _product/simulation/engine.py"
        }

        service rateResolver {
          title "L4 · RateResolver"
          description "Resolves fixed, locked tier, current-balance tier, and progressive-layer rates while recording the rules actually applied.\nSource: _product/simulation/engine.py"
        }

        service feeEvaluator {
          title "L4 · FeeEvaluator"
          description "Evaluates fixed/percentage fee and tax rules at upfront, per-period, or maturity timing with optional min/max caps.\nSource: _product/simulation/engine.py"
        }

        helper breakdownPolicy {
          title "L4 · _breakdown_interval() / _aggregate_rows()"
          description "Chooses auto-compact, auto-detailed, fixed, or custom intervals and aggregates monthly rows without changing financial totals; chart sampling is capped at 60 points.\nSource: _product/simulation/engine.py"
        }

        domainModel productSimulation {
          title "L4 · ProductSimulation"
          description "One-to-one optional product simulator profile with strategy, input domain, rate policy, display policy, readiness checks, and configuration version.\nSource: _product/models/simulation.py"
        }

        domainModel simulationRateTier {
          title "L4 · SimulationRateTier"
          description "Ordered amount/tenor rate band with lower-inclusive and upper-exclusive nominal bounds plus overlap and coverage validation.\nSource: _product/models/simulation.py"
        }

        domainModel simulationFeeRule {
          title "L4 · SimulationFeeRule"
          description "Ordered administration, provision, insurance, tax, or other charge rule with calculation basis, timing, and caps.\nSource: _product/models/simulation.py"
        }

        domainModel simulationBreakdownBand {
          title "L4 · SimulationBreakdownBand"
          description "Optional priority-based tenor band that overrides the display aggregation interval.\nSource: _product/models/simulation.py"
        }

        template productSimulatorTemplate {
          title "L4 · product_simulator.html"
          description "Conditionally rendered accessible form, summary cards, SVG chart shell, applied-rule note, breakdown table, and disclaimer.\nSource: cms/templates/cms/components/product_simulator.html"
        }

        browserScript productSimulatorBrowser {
          title "L4 · product-simulator.js"
          description "Auto-submits valid inputs, fetches the JSON endpoint, and renders summaries, SVG growth series, tooltips, rule labels, tables, and field errors.\nSource: cms/static/cms/js/product-simulator.js"
        }

        adminExtension productSimulationAdmin {
          title "L4 · ProductSimulationViewSet"
          description "Wagtail snippet editor with assistive setup, input, rate, fee/tax, display, custom breakdown, readiness, and advanced tabs.\nSource: _product/admin/product.py"
        }
      }

      component p2pDiscovery {
        title "L3 · P2P Project Discovery"
        description "Publishes funding opportunities, investment terms, slot availability, funding progress, and SEO."
        technology "Django ORM · Wagtail snippets/preview · Django templates"

        endpoint p2pListRoute {
          title "L4 · GET /peer-to-peer/"
          description "Named route: p2p_list. Lists published projects.\nSource: _p2p/urls.py"
        }

        endpoint p2pDetailRoute {
          title "L4 · GET /peer-to-peer/{slug}/"
          description "Named route: p2p_details. Shows a published funding opportunity.\nSource: _p2p/urls.py"
        }

        viewFunction p2pListView {
          title "L4 · p2p_list()"
          description "Queries published P2P projects with active categories.\nSource: _p2p/views/pages.py"
        }

        viewFunction p2pDetailView {
          title "L4 · p2p_detail()"
          description "Loads project, category, prospectus, StreamField content, and SEO.\nSource: _p2p/views/pages.py"
        }

        helper seoContext {
          title "L4 · _seo_context()"
          description "Loads section-specific P2P SEO defaults.\nSource: _p2p/views/pages.py"
        }

        domainModel p2pProject {
          title "L4 · P2P"
          description "Funding opportunity, pricing, capacity, return terms, publication state, availability, and aggregate progress.\nSource: _p2p/models/project.py"
        }

        domainModel p2pCategory {
          title "L4 · P2PCategory"
          description "Ordered and activatable P2P project classification.\nSource: _p2p/models/category.py"
        }

        settingsModel p2pSeo {
          title "L4 · P2PSEOSettings"
          description "Singleton SEO defaults for P2P list, detail, purchase, and completion pages.\nSource: _p2p/models/seo.py"
        }
      }

      component purchaseWorkflow {
        title "L3 · P2P Purchase Workflow"
        description "Validates investor input, locks project capacity, calculates immutable pricing, creates the purchase, and opens a Xendit Payment Session."
        technology "Django forms · ORM transactions · application services"

        endpoint purchaseRoute {
          title "L4 · GET|POST /peer-to-peer/{slug}/purchase/"
          description "Named route: p2p_purchase. Displays and submits the investor purchase form.\nSource: _p2p/urls.py"
        }

        viewFunction purchaseView {
          title "L4 · p2p_purchase()"
          description "Guards project availability, validates the form, invokes purchase creation, and redirects to the waiting page.\nSource: _p2p/views/pages.py"
        }

        form purchaseForm {
          title "L4 · P2PPurchaseForm"
          description "Validates name, phone, email, optional NIK/note, requested slots, and current availability.\nSource: _p2p/forms/purchase.py"
        }

        workflow createPurchase {
          title "L4 · create_p2p_purchase()"
          description "Locks the project, rechecks availability, snapshots price, creates P2PPurchase, creates a Xendit session, and moves creating → waiting_payment or failed.\nSource: _p2p/services/purchase_workflow.py"
        }

        service availabilityService {
          title "L4 · available_slot_count()"
          description "Calculates availability from purchases in reserving states.\nSource: _p2p/services/availability.py"
        }

        service pricingService {
          title "L4 · calculate_purchase_price()"
          description "Returns an immutable PurchasePrice snapshot from project slot price, quantity, and service fee.\nSource: _p2p/services/pricing.py"
        }

        domainModel purchasePrice {
          title "L4 · PurchasePrice"
          description "Immutable price snapshot: unit price, quantity, subtotal, service fee, and total.\nSource: _p2p/services/pricing.py"
        }

        domainModel p2pPurchase {
          title "L4 · P2PPurchase"
          description "Investor identity, price snapshot, status machine, Xendit identifiers/responses, webhook idempotency data, and email audit.\nSource: _p2p/models/purchase.py"
        }
      }

      component paymentExperience {
        title "L3 · Browser Payment Experience"
        description "Displays the Xendit payment link, polls the local status endpoint, handles browser return, and redirects a paid investor to completion."
        technology "Django templates · browser JavaScript · JSON endpoint"

        endpoint waitingRoute {
          title "L4 · GET /peer-to-peer/purchase/{public_id}/waiting/"
          description "Named route: p2p_purchase_waiting. Displays the payment frame and polling UI.\nSource: _p2p/urls.py"
        }

        viewFunction waitingView {
          title "L4 · p2p_waiting()"
          description "Loads the purchase; redirects paid purchases to completion; otherwise renders the waiting page.\nSource: _p2p/views/pages.py"
        }

        template waitingTemplate {
          title "L4 · p2p_waiting.html"
          description "Embeds purchase.payment_link_url in an iframe and initializes local status polling.\nSource: cms/templates/cms/pages/p2p_waiting.html"
        }

        browserScript paymentStatusPoller {
          title "L4 · checkPaymentStatus()"
          description "Calls the local status endpoint, updates UI state, stops on a final state, and redirects when redirect_url is returned.\nSource: cms/templates/cms/pages/p2p_waiting.html"
        }

        endpoint statusRoute {
          title "L4 · GET /api/p2p/purchases/{public_id}/status/"
          description "Named route: p2p_purchase_status. Returns local/provider status, final flag, and optional completion redirect.\nSource: _p2p/urls.py"
        }

        viewFunction statusView {
          title "L4 · purchase_status()"
          description "Reads the purchase and rate-limits active Xendit reconciliation to at most once per 10 seconds per purchase.\nSource: _p2p/views/status.py"
        }

        endpoint returnRoute {
          title "L4 · GET /api/p2p/xendit/return/{public_id}/"
          description "Iframe-safe Xendit browser return route.\nSource: _p2p/urls.py"
        }

        viewFunction returnView {
          title "L4 · p2p_xendit_return()"
          description "Builds a local absolute waiting-page URL and renders the browser-return bridge.\nSource: _p2p/views/pages.py"
        }

        endpoint completionRoute {
          title "L4 · GET /peer-to-peer/purchase/{public_id}/complete/"
          description "Named route: p2p_booking_complete. Available only after payment is paid.\nSource: _p2p/urls.py"
        }

        viewFunction completionView {
          title "L4 · p2p_complete()"
          description "Guards paid state, retries paid email up to three attempts, and builds WhatsApp confirmation.\nSource: _p2p/views/pages.py"
        }
      }

      component paymentReconciliation {
        title "L3 · Payment Reconciliation"
        description "Normalizes provider status from polling or webhook into one validated, transactional, and idempotent local transition."
        technology "Django JSON view · ORM transaction · shared transition service"

        endpoint webhookRoute {
          title "L4 · POST /api/p2p/webhooks/xendit/payment-session/"
          description "Named route: xendit_payment_session_webhook. Public Xendit callback endpoint.\nSource: _p2p/urls.py"
        }

        viewFunction webhookView {
          title "L4 · xendit_payment_session_webhook()"
          description "Validates callback token, JSON/event/reference, derives webhook id, rejects duplicates, and invokes the shared transition.\nSource: _p2p/views/webhook.py"
        }

        service synchronizePayment {
          title "L4 · synchronize_xendit_purchase()"
          description "Fetches Xendit session status and passes the response to the shared transition service.\nSource: _p2p/services/payment_sync.py"
        }

        service applyPaymentUpdate {
          title "L4 · apply_xendit_payment_update()"
          description "Locks purchase, validates reference/session/amount/currency, maps provider status, prevents paid-state regression, stores audit data, and schedules paid email after commit.\nSource: _p2p/services/payment_transition.py"
        }
      }

      component xenditAdapter {
        title "L3 · Xendit Adapter"
        description "Owns Xendit credentials, Basic authentication, Payment Session creation, status retrieval, timeout, and API error normalization."
        technology "requests · Xendit Payment Sessions API"

        service xenditService {
          title "L4 · XenditService"
          description "Provider adapter exposing create_invoice() and get_session_status().\nSource: backend/services/xendit.py"
        }

        helper xenditRequest {
          title "L4 · XenditService._request()"
          description "Executes authenticated JSON requests, applies timeouts, validates object responses, and converts provider/network errors.\nSource: backend/services/xendit.py"
        }

        service createXenditSession {
          title "L4 · XenditService.create_invoice()"
          description "Validates a positive whole-number IDR amount and POSTs a PAY/PAYMENT_LINK session to /sessions.\nSource: backend/services/xendit.py"
        }

        service getXenditSession {
          title "L4 · XenditService.get_session_status()"
          description "GETs /sessions/{session_id} for active reconciliation.\nSource: backend/services/xendit.py"
        }

        settingsModel xenditSetting {
          title "L4 · XenditSetting"
          description "Singleton provider configuration: activation, API URL/key, callback token, public/return base URLs, and session duration.\nSource: _setting/models/xendit.py"
        }
      }

      component notificationService {
        title "L3 · Paid Purchase Notification"
        description "Sends an idempotent HTML/text confirmation email after a purchase first becomes paid and records delivery attempts."
        technology "Django email · SMTP · Django templates"

        service sendPaidEmail {
          title "L4 · send_paid_email_safely()"
          description "Checks idempotency, increments attempts, loads SMTP/contact settings, renders email, attaches logo, sends, and records success/error.\nSource: _p2p/services/email_notification.py"
        }

        settingsModel emailSetting {
          title "L4 · EmailSetting"
          description "Singleton SMTP host, port, credentials, and TLS settings.\nSource: _setting/models/email.py"
        }

        template paymentEmailTemplates {
          title "L4 · Paid Purchase Email Templates"
          description "Subject, text, and HTML payment-success templates.\nSource: cms/templates/cms/emails/p2p/"
        }
      }

      component searchComponent {
        title "L3 · Unified Public Search"
        description "Ranks published P2P projects, products, and miscellaneous pages within the current Wagtail site."
        technology "Django ORM · Wagtail site/page queries"

        endpoint searchRoute {
          title "L4 · GET /search/"
          description "Named route: search. Accepts q and category.\nSource: backend/urls.py"
        }

        viewFunction searchView {
          title "L4 · search()"
          description "Builds and counts P2P, product, and page result sets with category selection.\nSource: search/views.py"
        }

        helper rankedQuery {
          title "L4 · _ranked()"
          description "Ranks exact, prefix, and substring title matches.\nSource: search/views.py"
        }
      }

      component cmsAdministration {
        title "L3 · Wagtail CMS & Settings"
        description "Manages pages, products, P2P projects/purchases, singleton settings, media, preview, and structured StreamField content."
        technology "Wagtail Admin · snippets · settings · images/documents"

        endpoint wagtailAdminRoutes {
          title "L4 · /admin/{wagtail_admin_path}"
          description "Framework route family: authenticated Wagtail dashboard, page/snippet/settings/image administration, previews, and registered custom admin URLs. Framework-generated routes are intentionally grouped.\nSource: backend/urls.py"
        }

        endpoint djangoAdminRoutes {
          title "L4 · /django-admin/{django_admin_path}"
          description "Framework route family: Django's built-in administrator site. Framework-generated routes are intentionally grouped.\nSource: backend/urls.py"
        }

        endpoint wagtailDocumentRoutes {
          title "L4 · /documents/{document_path}"
          description "Framework route family: Wagtail document serving. Framework-generated routes are intentionally grouped.\nSource: backend/urls.py"
        }

        adminExtension singletonSnippetFramework {
          title "L4 · SingletonSnippetViewSet"
          description "Redirects singleton snippet index/create paths to the one editable settings row.\nSource: backend/helper/singleton.py"
        }

        domainModel singletonModel {
          title "L4 · SingletonModel"
          description "Abstract load-or-create singleton persistence contract.\nSource: backend/helper/singleton_model.py"
        }

        adminExtension p2pAdminGroup {
          title "L4 · P2PAdminGroup"
          description "Groups project, category, purchase, and P2P SEO administration.\nSource: _p2p/admin/p2p.py"
        }

        adminExtension productAdmin {
          title "L4 · Product Admin ViewSets"
          description "Registers product and category management in Wagtail snippets.\nSource: _product/admin/product.py"
        }

        adminExtension settingsAdmin {
          title "L4 · General Settings Admin"
          description "Registers contact, email, Xendit, homepage, and other singleton settings.\nSource: _setting/admin/settings.py"
        }
      }

      component adminOperations {
        title "L3 · Admin Operations & Reporting"
        description "Provides an operational dashboard, global search, funding reports, purchase inspection, and CSV export."
        technology "Wagtail hooks/components · Django ORM aggregation · CSV"

        endpoint globalAdminSearchRoute {
          title "L4 · GET /admin/global-search/"
          description "Named route: ks3_admin_search. Custom authenticated Wagtail global-search endpoint.\nSource: cms/wagtail_hooks.py"
        }

        adminExtension adminDashboard {
          title "L4 · KS3DashboardPanel"
          description "Summarizes paid/waiting/failed purchases and open project progress on the Wagtail homepage.\nSource: cms/admin_dashboard.py"
        }

        viewFunction globalAdminSearch {
          title "L4 · global_admin_search()"
          description "Searches P2P projects, purchases, products, and Wagtail pages for authorized administrators.\nSource: cms/admin_views.py"
        }

        service projectReport {
          title "L4 · build_project_report()"
          description "Aggregates funding totals, conversion, trends, statuses, and top buyers.\nSource: _p2p/reporting.py"
        }

        endpoint exportPurchasesRoute {
          title "L4 · GET /admin/p2p/projects/{project_id}/purchases.csv"
          description "Named route: p2p_project_purchase_export. Permission-gated CSV download registered through Wagtail admin hooks.\nSource: _p2p/wagtail_hooks.py"
        }

        viewFunction exportPurchases {
          title "L4 · export_project_purchases()"
          description "Exports a project's purchase data as CSV for authorized administrators.\nSource: _p2p/admin/views.py"
        }
      }
    }

    database postgres {
      title "L2 · PostgreSQL Database"
      description "Production relational store for Django/Wagtail auth, sessions, pages, settings, catalogue, P2P projects, purchases, and audit payloads. Development base settings fall back to SQLite; tests use in-memory SQLite."
      technology "PostgreSQL in production/dev · SQLite fallback/test"
    }

    container operationsCli {
      title "L2 · Django Operational CLI"
      description "On-demand management-command runtime using the same Django code, settings, database, and provider integrations as the web application."
      technology "python manage.py"

      component acceptanceHarness {
        title "L3 · P2P End-to-End Acceptance Harness"
        description "Creates or resumes a real purchase, validates form data, opens a Xendit session, and observes payment via polling or webhook."
        technology "Django management command"

        managementCommand simulatePurchase {
          title "L4 · simulate_p2p_purchase"
          description "Interactive real-provider scenario runner with poll/webhook modes, timeout, resume support, and non-zero failure exits.\nSource: _p2p/management/commands/simulate_p2p_purchase.py"
        }

        helper selectProject {
          title "L4 · Command._select_project()"
          description "Lists and selects currently purchasable projects.\nSource: _p2p/management/commands/simulate_p2p_purchase.py"
        }

        helper collectForm {
          title "L4 · Command._collect_form()"
          description "Collects investor data and validates it with the production P2PPurchaseForm.\nSource: _p2p/management/commands/simulate_p2p_purchase.py"
        }

        helper waitForPayment {
          title "L4 · Command._wait()"
          description "Observes local state; optionally polls Xendit until paid, terminal failure, or timeout.\nSource: _p2p/management/commands/simulate_p2p_purchase.py"
        }
      }

      component seedCommands {
        title "L3 · Content Seed Commands"
        description "Seeds showcase products, projects, settings, and miscellaneous pages for controlled environments."
        technology "Django management commands"

        managementCommand seedP2p {
          title "L4 · seed_p2p_showcase"
          description "Seeds P2P demonstration content.\nSource: _p2p/management/commands/seed_p2p_showcase.py"
        }

        managementCommand seedProducts {
          title "L4 · seed_product_showcase"
          description "Seeds seven savings and loan product pages and invokes the deterministic simulator seed helper in the same transaction.\nSource: _product/management/commands/seed_product_showcase.py"
        }

        managementCommand seedProductSimulators {
          title "L4 · seed_product_simulators"
          description "Seeds or replaces simulator profiles for existing known product slugs without downloading images or rewriting product content; --strict rejects missing products.\nSource: _product/management/commands/seed_product_simulators.py"
        }

        helper currentProductSimulationSeeds {
          title "L4 · seed_product_simulations() / SIMULATION_SEEDS"
          description "Idempotently maps the seven current product slugs to strategy-specific illustrative savings and loan profiles, tiers, fees, display state, and disclaimers inside a database transaction.\nSource: _product/management/simulation_seed.py"
        }

        managementCommand seedSettings {
          title "L4 · seed_homepage_settings"
          description "Seeds homepage singleton settings.\nSource: _setting/management/commands/seed_homepage_settings.py"
        }

        managementCommand seedPages {
          title "L4 · seed_misc_pages"
          description "Seeds public miscellaneous Wagtail pages.\nSource: _misc/management/commands/seed_misc_pages.py"
        }
      }
    }
  }

