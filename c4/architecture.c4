  ks3Platform.webApplication.searchComponent.searchView -> ks3Platform.webApplication.p2pDiscovery.p2pProject "Searches published projects"
  ks3Platform.webApplication.searchComponent.searchView -> ks3Platform.webApplication.productCatalogue.product "Searches published products"
  ks3Platform.webApplication.searchComponent.searchView -> ks3Platform.webApplication.publicExperience.miscellaneousPage "Searches live public pages"

  administrator -> ks3Platform.webApplication.cmsAdministration.wagtailAdminRoutes "Uses authenticated Wagtail Admin"
  administrator -> ks3Platform.webApplication.cmsAdministration.djangoAdminRoutes "Uses Django Admin when explicitly required"
  ks3Platform.webApplication.cmsAdministration.wagtailAdminRoutes -> ks3Platform.webApplication.cmsAdministration.singletonSnippetFramework "Dispatches custom snippet/settings administration"
  ks3Platform.webApplication.cmsAdministration.wagtailAdminRoutes -> ks3Platform.webApplication.cmsAdministration.p2pAdminGroup "Dispatches P2P administration"
  ks3Platform.webApplication.cmsAdministration.wagtailAdminRoutes -> ks3Platform.webApplication.cmsAdministration.productAdmin "Dispatches product administration"
  ks3Platform.webApplication.cmsAdministration.wagtailAdminRoutes -> ks3Platform.webApplication.cmsAdministration.settingsAdmin "Dispatches settings administration"
  ks3Platform.webApplication.cmsAdministration.wagtailDocumentRoutes -> objectStorage "Serves stored documents"
  ks3Platform.webApplication.cmsAdministration.singletonSnippetFramework -> ks3Platform.webApplication.cmsAdministration.singletonModel "Provides singleton edit behavior"
  ks3Platform.webApplication.cmsAdministration.p2pAdminGroup -> ks3Platform.webApplication.p2pDiscovery.p2pProject "Manages projects"
  ks3Platform.webApplication.cmsAdministration.p2pAdminGroup -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Manages purchases"
  ks3Platform.webApplication.cmsAdministration.productAdmin -> ks3Platform.webApplication.productCatalogue.product "Manages products"
  administrator -> ks3Platform.webApplication.productSimulator.productSimulationAdmin "Configure optional product simulations"
  ks3Platform.webApplication.cmsAdministration.settingsAdmin -> ks3Platform.webApplication.publicExperience.homePageSetting "Manages homepage"
  ks3Platform.webApplication.cmsAdministration.settingsAdmin -> ks3Platform.webApplication.xenditAdapter.xenditSetting "Manages provider settings"
  ks3Platform.webApplication.cmsAdministration.settingsAdmin -> ks3Platform.webApplication.notificationService.emailSetting "Manages SMTP settings"

  ks3Platform.webApplication.cmsAdministration.wagtailAdminRoutes -> ks3Platform.webApplication.adminOperations.adminDashboard "Renders custom dashboard"
  ks3Platform.webApplication.cmsAdministration.wagtailAdminRoutes -> ks3Platform.webApplication.adminOperations.globalAdminSearchRoute "Mounts custom search URL"
  ks3Platform.webApplication.adminOperations.globalAdminSearchRoute -> ks3Platform.webApplication.adminOperations.globalAdminSearch "Routes authorized search"
  ks3Platform.webApplication.cmsAdministration.wagtailAdminRoutes -> ks3Platform.webApplication.adminOperations.exportPurchasesRoute "Mounts project CSV URL"
  ks3Platform.webApplication.adminOperations.exportPurchasesRoute -> ks3Platform.webApplication.adminOperations.exportPurchases "Routes authorized export"
  ks3Platform.webApplication.adminOperations.adminDashboard -> ks3Platform.webApplication.p2pDiscovery.p2pProject "Summarizes open projects"
  ks3Platform.webApplication.adminOperations.adminDashboard -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Aggregates payment state and totals"
  ks3Platform.webApplication.adminOperations.globalAdminSearch -> ks3Platform.webApplication.p2pDiscovery.p2pProject "Searches projects"
  ks3Platform.webApplication.adminOperations.globalAdminSearch -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Searches transactions"
  ks3Platform.webApplication.adminOperations.globalAdminSearch -> ks3Platform.webApplication.productCatalogue.product "Searches products"
  ks3Platform.webApplication.adminOperations.globalAdminSearch -> ks3Platform.webApplication.publicExperience.miscellaneousPage "Searches Wagtail pages"
  ks3Platform.webApplication.adminOperations.projectReport -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Aggregates project funding metrics"
  ks3Platform.webApplication.adminOperations.exportPurchases -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Exports project transactions"

  // ---------------------------------------------------------------------------
  // L4 relationships — operational CLI
  // ---------------------------------------------------------------------------

  ks3Platform.operationsCli.acceptanceHarness.simulatePurchase -> ks3Platform.operationsCli.acceptanceHarness.selectProject "Selects scenario project"
  ks3Platform.operationsCli.acceptanceHarness.selectProject -> ks3Platform.webApplication.p2pDiscovery.p2pProject "Queries purchasable projects"
  ks3Platform.operationsCli.acceptanceHarness.simulatePurchase -> ks3Platform.operationsCli.acceptanceHarness.collectForm "Collects scenario data"
  ks3Platform.operationsCli.acceptanceHarness.collectForm -> ks3Platform.webApplication.purchaseWorkflow.purchaseForm "Reuses production validation"
  ks3Platform.operationsCli.acceptanceHarness.simulatePurchase -> ks3Platform.webApplication.purchaseWorkflow.createPurchase "Runs real creation workflow"
  ks3Platform.operationsCli.acceptanceHarness.simulatePurchase -> ks3Platform.operationsCli.acceptanceHarness.waitForPayment "Observes completion"
  ks3Platform.operationsCli.acceptanceHarness.waitForPayment -> ks3Platform.webApplication.paymentReconciliation.synchronizePayment "Poll mode reconciles provider"
  ks3Platform.operationsCli.acceptanceHarness.waitForPayment -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Webhook mode observes database state"
  ks3Platform.operationsCli.seedCommands.seedP2p -> ks3Platform.webApplication.p2pDiscovery.p2pProject "Creates showcase opportunities"
  ks3Platform.operationsCli.seedCommands.seedProducts -> ks3Platform.webApplication.productCatalogue.product "Creates showcase products"
  ks3Platform.operationsCli.seedCommands.seedProducts -> ks3Platform.operationsCli.seedCommands.currentProductSimulationSeeds "Seed simulator profiles after products"
  ks3Platform.operationsCli.seedCommands.seedProductSimulators -> ks3Platform.operationsCli.seedCommands.currentProductSimulationSeeds "Seed profiles without rewriting product content"
  ks3Platform.operationsCli.seedCommands.currentProductSimulationSeeds -> ks3Platform.webApplication.productSimulator.productSimulation "Upsert seven product-specific profiles and replace child rules atomically"
  ks3Platform.operationsCli.seedCommands.seedSettings -> ks3Platform.webApplication.publicExperience.homePageSetting "Creates homepage configuration"
  ks3Platform.operationsCli.seedCommands.seedPages -> ks3Platform.webApplication.publicExperience.miscellaneousPage "Creates information pages"
}

views {
  // ---------------------------------------------------------------------------
  // L1 — System Context
  // ---------------------------------------------------------------------------

  view L1_01_System_Context {
    title "L1 — System Context — Koperasi KS3 Digital Platform"
    description "Who uses the platform and which external systems it depends on. No containers, components, or code are expanded."
    include visitor, investor, administrator, operator, ks3Platform, xendit, objectStorage, smtpProvider
  }

  view L1_02_P2P_Payment_Context {
    title "L1 — System Context — P2P Funding & Payment"
    description "Context focused on the investor journey and external payment/email dependencies."
    include investor, administrator, ks3Platform, xendit, smtpProvider
  }

  // ---------------------------------------------------------------------------
  // L2 — Containers
  // ---------------------------------------------------------------------------

  view L2_01_Container_Overview {
    title "L2 — Container — Runtime & Data Boundaries"
    description "Deployable/runnable units: web process, relational database, and on-demand operational CLI."
    include visitor, investor, administrator, operator
    include ks3Platform.webApplication, ks3Platform.postgres, ks3Platform.operationsCli
    include xendit, objectStorage, smtpProvider
  }

  view L2_02_Production_Deployment_Responsibilities {
    title "L2 — Container — Production Responsibilities"
    description "Production web runtime and its external infrastructure dependencies. Reverse proxy/host infrastructure is not present in repository configuration and is intentionally not invented."
    include administrator, investor
    include ks3Platform.webApplication, ks3Platform.postgres
    include xendit, objectStorage, smtpProvider
  }

  // ---------------------------------------------------------------------------
  // L3 — Components
  // ---------------------------------------------------------------------------

  view L3_01_Web_Application_Components {
    title "L3 — Component — Django/Wagtail Web Application"
