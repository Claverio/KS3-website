  // ---------------------------------------------------------------------------
  // FLOW — Dynamic views (supporting C4 views, not a fifth level)
  // ---------------------------------------------------------------------------

  dynamic view FLOW_01_Browse_and_Discover {
    title "FLOW — Browse Homepage, Products & P2P Opportunities"
    description "Public discovery flow across homepage composition, catalogue, and published P2P data."
    visitor -> ks3Platform.webApplication.publicExperience.landingRoute "GET /"
    ks3Platform.webApplication.publicExperience.landingRoute -> ks3Platform.webApplication.publicExperience.landingView "Dispatch route"
    ks3Platform.webApplication.publicExperience.landingView -> ks3Platform.webApplication.publicExperience.homePageSetting "Load homepage configuration"
    ks3Platform.webApplication.publicExperience.landingView -> ks3Platform.webApplication.productCatalogue.product "Query featured products"
    ks3Platform.webApplication.publicExperience.landingView -> ks3Platform.webApplication.p2pDiscovery.p2pProject "Query featured opportunities"
    ks3Platform.webApplication.publicExperience.landingView -> ks3Platform.webApplication.publicExperience.publicTemplates "Render public homepage"
  }

  dynamic view FLOW_02_Create_P2P_Purchase {
    title "FLOW — Create P2P Purchase & Xendit Session"
    description "Happy-path transaction from investor form submission to waiting-payment state."
    investor -> ks3Platform.webApplication.purchaseWorkflow.purchaseRoute "POST purchase form"
    ks3Platform.webApplication.purchaseWorkflow.purchaseRoute -> ks3Platform.webApplication.purchaseWorkflow.purchaseView "Route request"
    ks3Platform.webApplication.purchaseWorkflow.purchaseView -> ks3Platform.webApplication.purchaseWorkflow.purchaseForm "Validate identity and slots"
    ks3Platform.webApplication.purchaseWorkflow.purchaseView -> ks3Platform.webApplication.purchaseWorkflow.createPurchase "Execute workflow"
    ks3Platform.webApplication.purchaseWorkflow.createPurchase -> ks3Platform.webApplication.p2pDiscovery.p2pProject "Lock and recheck project"
    ks3Platform.webApplication.purchaseWorkflow.createPurchase -> ks3Platform.webApplication.purchaseWorkflow.pricingService "Snapshot price"
    ks3Platform.webApplication.purchaseWorkflow.createPurchase -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Create status=creating"
    ks3Platform.webApplication.purchaseWorkflow.createPurchase -> ks3Platform.webApplication.xenditAdapter.createXenditSession "Create Payment Session"
    ks3Platform.webApplication.xenditAdapter.createXenditSession -> xendit "POST /sessions"
    ks3Platform.webApplication.purchaseWorkflow.createPurchase -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Store session and status=waiting_payment"
  }

  dynamic view FLOW_03_Browser_Status_Polling {
    title "FLOW — Browser Payment Status Polling"
    description "Browser polls the local backend; backend rate-limits active reconciliation with Xendit."
    investor -> ks3Platform.webApplication.paymentExperience.waitingTemplate "Open waiting page"
    ks3Platform.webApplication.paymentExperience.waitingTemplate -> xendit "Display payment iframe"
    ks3Platform.webApplication.paymentExperience.paymentStatusPoller -> ks3Platform.webApplication.paymentExperience.statusRoute "GET local status"
    ks3Platform.webApplication.paymentExperience.statusRoute -> ks3Platform.webApplication.paymentExperience.statusView "Route request"
    ks3Platform.webApplication.paymentExperience.statusView -> ks3Platform.webApplication.paymentReconciliation.synchronizePayment "Reconcile if pending and throttle acquired"
    ks3Platform.webApplication.paymentReconciliation.synchronizePayment -> ks3Platform.webApplication.xenditAdapter.getXenditSession "Request provider state"
    ks3Platform.webApplication.xenditAdapter.getXenditSession -> xendit "GET /sessions/{id}"
    ks3Platform.webApplication.paymentReconciliation.synchronizePayment -> ks3Platform.webApplication.paymentReconciliation.applyPaymentUpdate "Apply validated transition"
    ks3Platform.webApplication.paymentExperience.statusView -> ks3Platform.webApplication.paymentExperience.paymentStatusPoller "Return JSON status/redirect"
    ks3Platform.webApplication.paymentExperience.paymentStatusPoller -> ks3Platform.webApplication.paymentExperience.completionRoute "Redirect when paid"
  }

  dynamic view FLOW_04_Xendit_Webhook {
    title "FLOW — Xendit Webhook Reconciliation"
    description "Provider callback reaches the same idempotent transition service used by polling."
    xendit -> ks3Platform.webApplication.paymentReconciliation.webhookRoute "POST payment-session event"
    ks3Platform.webApplication.paymentReconciliation.webhookRoute -> ks3Platform.webApplication.paymentReconciliation.webhookView "Route callback"
    ks3Platform.webApplication.paymentReconciliation.webhookView -> ks3Platform.webApplication.xenditAdapter.xenditSetting "Validate x-callback-token"
    ks3Platform.webApplication.paymentReconciliation.webhookView -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Resolve reference and reject duplicate webhook id"
    ks3Platform.webApplication.paymentReconciliation.webhookView -> ks3Platform.webApplication.paymentReconciliation.applyPaymentUpdate "Validate and apply provider state"
    ks3Platform.webApplication.paymentReconciliation.applyPaymentUpdate -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Persist status and audit atomically"
    ks3Platform.webApplication.paymentReconciliation.applyPaymentUpdate -> ks3Platform.webApplication.notificationService.sendPaidEmail "On first paid transition, schedule after commit"
  }

  dynamic view FLOW_05_Paid_Email_Notification {
    title "FLOW — Paid Purchase Email"
    description "Idempotent email delivery and audit after a successful payment."
    ks3Platform.webApplication.paymentReconciliation.applyPaymentUpdate -> ks3Platform.webApplication.notificationService.sendPaidEmail "Invoke after database commit"
    ks3Platform.webApplication.notificationService.sendPaidEmail -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Check sent flag and increment attempt"
    ks3Platform.webApplication.notificationService.sendPaidEmail -> ks3Platform.webApplication.notificationService.emailSetting "Load SMTP credentials"
    ks3Platform.webApplication.notificationService.sendPaidEmail -> ks3Platform.webApplication.publicExperience.contactSetting "Load reply-to identity"
    ks3Platform.webApplication.notificationService.sendPaidEmail -> ks3Platform.webApplication.notificationService.paymentEmailTemplates "Render subject/text/HTML"
    ks3Platform.webApplication.notificationService.sendPaidEmail -> smtpProvider "Send email"
    ks3Platform.webApplication.notificationService.sendPaidEmail -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Record success or truncated error"
  }

  dynamic view FLOW_06_Admin_Funding_Report {
    title "FLOW — Administrator Funding Report"
    description "Admin opens project operations and receives aggregated funding and transaction data."
    administrator -> ks3Platform.webApplication.adminOperations.adminDashboard "Open Wagtail dashboard"
    ks3Platform.webApplication.adminOperations.adminDashboard -> ks3Platform.webApplication.p2pDiscovery.p2pProject "Load open projects"
    ks3Platform.webApplication.adminOperations.adminDashboard -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Aggregate paid/waiting/failed totals"
    administrator -> ks3Platform.webApplication.adminOperations.projectReport "Open project report"
    ks3Platform.webApplication.adminOperations.projectReport -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Build trends/statuses/top buyers"
    administrator -> ks3Platform.webApplication.adminOperations.exportPurchases "Export CSV when required"
  }

  dynamic view FLOW_07_Acceptance_CLI {
    title "FLOW — End-to-End P2P Acceptance CLI"
    description "Operator executes the same production flow and chooses provider polling or webhook-only observation."
    operator -> ks3Platform.operationsCli.acceptanceHarness.simulatePurchase "Run manage.py simulate_p2p_purchase"
    ks3Platform.operationsCli.acceptanceHarness.simulatePurchase -> ks3Platform.operationsCli.acceptanceHarness.selectProject "Select purchasable project"
    ks3Platform.operationsCli.acceptanceHarness.simulatePurchase -> ks3Platform.operationsCli.acceptanceHarness.collectForm "Collect and validate investor data"
    ks3Platform.operationsCli.acceptanceHarness.simulatePurchase -> ks3Platform.webApplication.purchaseWorkflow.createPurchase "Create real purchase/session"
    ks3Platform.operationsCli.acceptanceHarness.simulatePurchase -> ks3Platform.operationsCli.acceptanceHarness.waitForPayment "Observe selected mode"
    ks3Platform.operationsCli.acceptanceHarness.waitForPayment -> ks3Platform.webApplication.paymentReconciliation.synchronizePayment "Poll mode: reconcile Xendit"
    ks3Platform.operationsCli.acceptanceHarness.waitForPayment -> ks3Platform.webApplication.purchaseWorkflow.p2pPurchase "Webhook mode: observe local state"
  }

  dynamic view FLOW_08_Product_Financial_Simulation {
    title "FLOW — Calculate and Render Product Financial Simulation"
    description "A visitor opens a published product with a ready profile, submits bounded inputs, and receives reconciled summary, growth graph, applied rules, and adaptive breakdown."
    visitor -> ks3Platform.webApplication.productCatalogue.productDetailRoute "Open published product"
    ks3Platform.webApplication.productCatalogue.productDetailRoute -> ks3Platform.webApplication.productCatalogue.productDetailView "Route request"
    ks3Platform.webApplication.productCatalogue.productDetailView -> ks3Platform.webApplication.productSimulator.simulationContext "Check optional profile readiness"
    ks3Platform.webApplication.productSimulator.simulationContext -> ks3Platform.webApplication.productSimulator.productSimulation "Require enabled and complete configuration"
    ks3Platform.webApplication.productCatalogue.productDetailView -> ks3Platform.webApplication.productSimulator.productSimulatorTemplate "Render bounded form and disclaimer"
    ks3Platform.webApplication.productSimulator.productSimulatorTemplate -> ks3Platform.webApplication.productSimulator.productSimulatorBrowser "Auto-submit default or member inputs"
    ks3Platform.webApplication.productSimulator.productSimulatorBrowser -> ks3Platform.webApplication.productSimulator.productSimulationRoute "GET amount, tenor, and recurring amount"
    ks3Platform.webApplication.productSimulator.productSimulationRoute -> ks3Platform.webApplication.productSimulator.productSimulationView "Dispatch read-only request"
    ks3Platform.webApplication.productSimulator.productSimulationView -> ks3Platform.webApplication.productSimulator.simulationEngine "Validate domain and calculate monthly schedule"
    ks3Platform.webApplication.productSimulator.simulationEngine -> ks3Platform.webApplication.productSimulator.rateResolver "Resolve and audit applied rate"
    ks3Platform.webApplication.productSimulator.simulationEngine -> ks3Platform.webApplication.productSimulator.feeEvaluator "Apply fee and tax timing"
    ks3Platform.webApplication.productSimulator.simulationEngine -> ks3Platform.webApplication.productSimulator.breakdownPolicy "Aggregate table and chart series"
    ks3Platform.webApplication.productSimulator.productSimulationView -> ks3Platform.webApplication.productSimulator.productSimulatorBrowser "Return normalized JSON or field errors"
    ks3Platform.webApplication.productSimulator.productSimulatorBrowser -> ks3Platform.webApplication.productSimulator.productSimulatorTemplate "Render summary, graph, rules, table, and disclaimer"
  }

  dynamic view FLOW_09_Seed_Current_Product_Simulators {
    title "FLOW — Seed Current Product Simulator Profiles"
    description "An operator runs the dedicated command; one transaction maps known existing slugs to deterministic strategy-specific profiles and child rules, or fails in strict mode when a product is missing."
    operator -> ks3Platform.operationsCli.seedCommands.seedProductSimulators "Run manage.py seed_product_simulators --strict"
    ks3Platform.operationsCli.seedCommands.seedProductSimulators -> ks3Platform.operationsCli.seedCommands.currentProductSimulationSeeds "Start transactional preset upsert"
    ks3Platform.operationsCli.seedCommands.currentProductSimulationSeeds -> ks3Platform.webApplication.productCatalogue.product "Resolve seven known product slugs"
    ks3Platform.operationsCli.seedCommands.currentProductSimulationSeeds -> ks3Platform.webApplication.productSimulator.productSimulation "Upsert validated profile and public display state"
    ks3Platform.operationsCli.seedCommands.currentProductSimulationSeeds -> ks3Platform.webApplication.productSimulator.simulationRateTier "Replace deterministic tenor/amount tiers"
    ks3Platform.operationsCli.seedCommands.currentProductSimulationSeeds -> ks3Platform.webApplication.productSimulator.simulationFeeRule "Replace deterministic fee and tax rules"
  }
}
